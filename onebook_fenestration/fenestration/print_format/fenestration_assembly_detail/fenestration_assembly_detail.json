{
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Fenestration Project",
 "doctype": "Print Format",
 "html": "<style>\n\t@page { size: A4; margin: 12mm; }\n\t.fen-doc { font-family: Inter, Helvetica, Arial, sans-serif; font-size: 9.5pt; color: #171717; line-height: 1.4; }\n\t.fen-doc h1, .fen-doc h2, .fen-doc h3 { color: #171717; margin: 0 0 6px; font-weight: 600; }\n\t.fen-doc h1 { font-size: 15pt; }\n\t.fen-doc h2 { font-size: 11.5pt; }\n\t.fen-doc table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }\n\t.fen-doc th, .fen-doc td { border: 1px solid #D4D4D4; padding: 3px 6px; text-align: left; vertical-align: top; }\n\t.fen-doc th { font-weight: 600; background: #F5F5F5; }\n\t.fen-doc td.num, .fen-doc th.num { text-align: right; }\n\t.fen-doc .muted { color: #525252; }\n\t.fen-doc .block { page-break-inside: avoid; margin-bottom: 14px; }\n\t.fen-doc .page-break-after { page-break-after: always; }\n\t.fen-doc img.drawing { max-width: 60mm; max-height: 60mm; }\n\t.fen-doc .drawing-missing { color: #737373; font-style: italic; padding: 20px 0; }\n\t.fen-doc .caption { font-size: 8pt; color: #525252; text-align: center; }\n\t.fen-doc .box { display: inline-block; width: 11px; height: 11px; border: 1px solid #171717; vertical-align: middle; margin: 0 3px 0 6px; }\n\t.fen-doc .sign { height: 60px; }\n\t.fen-doc .card td { border: 1px solid #D4D4D4; }\n</style>\n{% macro company_head() %}\n{% set header = fen_company_header(doc.company) %}\n{% if not no_letterhead %}\n<table style=\"border:0; border-bottom:1px solid #D4D4D4\"><tr>\n\t<td style=\"border:0; width:20%\">{% if header.logo %}<img src=\"{{ header.logo }}\" style=\"max-height:18mm; max-width:40mm\">{% endif %}</td>\n\t<td style=\"border:0\"><b>{{ header.name }}</b><br>{{ header.address }}</td>\n</tr></table>\n{% endif %}\n{% endmacro %}\n<div class=\"fen-doc\">\n{{ company_head() }}\n{% set blocks = fen_assembly_detail(doc) %}\n<h1>{{ _(\"Assembly Detail\") }}</h1>\n<p class=\"muted\">{{ doc.project_title|e }} &middot; {{ doc.name }}</p>\n{% for b in blocks %}\n{% set uri = fen_svg_data_uri(b.svg) %}\n<div class=\"block\">\n\t<table style=\"border:0\"><tr>\n\t\t<td style=\"border:0; width:30%\">{% if uri %}<img class=\"drawing\" src=\"{{ uri }}\" alt=\"{{ b.ref }}\">{% else %}<div class=\"drawing-missing\">{{ _(\"Drawing not available\") }}</div>{% endif %}</td>\n\t\t<td style=\"border:0\"><h2>{{ b.ref }} &mdash; {{ b.name }}</h2>\n\t\t\t<div class=\"muted\">{{ _(\"Qty\") }} {{ b.qty }} &middot; {{ b.width }} &times; {{ b.height }}</div></td>\n\t</tr></table>\n\t<table>\n\t\t<tr><th>{{ _(\"Panel\") }}</th><th>{{ _(\"Position\") }}</th><th>{{ _(\"Profile\") }}</th><th>{{ _(\"Profile Name\") }}</th><th class=\"num\">{{ _(\"Length\") }}</th><th>{{ _(\"Angles\") }}</th><th class=\"num\">{{ _(\"Qty / Window\") }}</th></tr>\n\t\t{% for p in b.pieces %}\n\t\t<tr><td>{{ p.panel }}</td><td>{{ p.position }}</td><td>{{ p.profile }}</td><td>{{ p.profile_name }}</td><td class=\"num\">{{ p.length }}</td><td>{{ p.angles }}</td><td class=\"num\">{{ p.qty_per_window }}</td></tr>\n\t\t{% endfor %}\n\t</table>\n</div>\n{% endfor %}\n{% if not no_letterhead and footer %}<div class=\"letter-head-footer\">{{ footer }}</div>{% endif %}\n</div>\n",
 "module": "Fenestration",
 "name": "Fenestration Assembly Detail",
 "print_format_type": "Jinja",
 "standard": "Yes"
}
