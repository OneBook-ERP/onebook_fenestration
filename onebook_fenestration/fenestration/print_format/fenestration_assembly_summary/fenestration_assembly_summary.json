{
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Fenestration Project",
 "doctype": "Print Format",
 "html": "<style>\n\t@page { size: A4; margin: 11mm 12mm 13mm 12mm; }\n\t.fen-doc { font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif; font-size: 8.8pt; color: #0F172A; line-height: 1.4; }\n\t.fen-doc * { box-sizing: border-box; }\n\t.fen-doc h1, .fen-doc h2, .fen-doc h3 { color: #0F172A; margin: 0 0 5px; font-weight: 700; }\n\t.fen-doc h1 { font-size: 14pt; letter-spacing: -0.01em; }\n\t.fen-doc h2 { font-size: 10.5pt; letter-spacing: -0.005em; }\n\t.fen-doc h3 { font-size: 9pt; }\n\t.fen-doc table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }\n\t.fen-doc thead { display: table-header-group; }\n\t.fen-doc tr { page-break-inside: avoid; }\n\t.fen-doc th, .fen-doc td { border: 1px solid #CBD5E1; padding: 4px 6px; text-align: left; vertical-align: top; }\n\t.fen-doc th { font-weight: 600; font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.04em; background: #F1F5F9; color: #334155; }\n\t.fen-doc td.num, .fen-doc th.num { text-align: right; font-variant-numeric: tabular-nums; }\n\t.fen-doc tr.total-row th, .fen-doc tr.total-row td { background: #F8FAFC; font-weight: 700; border-top: 1.5px solid #0F172A; }\n\t.fen-doc .muted { color: #64748B; }\n\t.fen-doc .small { font-size: 7.8pt; }\n\t.fen-doc .kicker { font-size: 7.2pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #64748B; }\n\t.fen-doc .header-bar { width: 100%; border-collapse: collapse; margin-bottom: 10px; border-bottom: 2px solid #0F172A; }\n\t.fen-doc .header-bar td { border: 0; padding: 0 0 8px 0; vertical-align: middle; }\n\t.fen-doc .kpi-strip { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 10px; background: #F8FAFC; }\n\t.fen-doc .kpi-strip td { border: 1px solid #CBD5E1; padding: 5px 8px; vertical-align: top; }\n\t.fen-doc .kpi-label { font-size: 7pt; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748B; margin-bottom: 1px; }\n\t.fen-doc .kpi-val { font-size: 10pt; font-weight: 700; color: #0F172A; }\n\t.fen-doc .section-title { font-size: 9.5pt; font-weight: 700; color: #0F172A; text-transform: uppercase; letter-spacing: 0.04em; border-left: 3px solid #0F172A; padding-left: 7px; margin: 10px 0 6px; }\n\t.fen-doc .block { page-break-inside: avoid; margin-bottom: 11px; }\n\t.fen-doc .card { border: 1px solid #CBD5E1; page-break-inside: avoid; margin-bottom: 10px; }\n\t.fen-doc .card-head { background: #0F172A; color: #FFFFFF; padding: 5px 8px; }\n\t.fen-doc .card-head-light { background: #F1F5F9; color: #0F172A; border-bottom: 1px solid #CBD5E1; padding: 5px 8px; }\n\t.fen-doc .page-break-after { page-break-after: always; }\n\t.fen-doc .drawing-box { background: #FAFBFD; border: 1px solid #E2E8F0; padding: 5px; text-align: center; }\n\t.fen-doc img.drawing { max-width: 54mm; max-height: 50mm; display: inline-block; }\n\t.fen-doc img.thumb { max-width: 14mm; max-height: 14mm; display: inline-block; }\n\t.fen-doc .drawing-missing { color: #94A3B8; font-style: italic; padding: 18px 4px; font-size: 8pt; }\n\t.fen-doc .caption { font-size: 7.2pt; color: #64748B; text-align: center; margin-top: 2px; }\n\t.fen-doc .pill { display: inline-block; padding: 1px 6px; font-size: 7.3pt; font-weight: 600; border-radius: 3px; border: 1px solid #CBD5E1; background: #F1F5F9; color: #1E293B; }\n\t.fen-doc .pill-dark { background: #0F172A; color: #FFFFFF; border-color: #0F172A; }\n\t.fen-doc .pill-green { background: #ECFDF5; color: #065F46; border-color: #A7F3D0; }\n\t.fen-doc .pill-amber { background: #FFFBEB; color: #92400E; border-color: #FDE68A; }\n\t.fen-doc .pill-red { background: #FEF2F2; color: #991B1B; border-color: #FECACA; }\n\t.fen-doc .swatch { display: inline-block; width: 8px; height: 8px; border-radius: 50%; border: 1px solid #94A3B8; vertical-align: middle; margin-right: 4px; }\n\t.fen-doc .box { display: inline-block; width: 10px; height: 10px; border: 1px solid #334155; vertical-align: middle; margin: 0 3px 0 4px; }\n\t.fen-doc .sign { height: 42px; }\n\t.fen-doc .unplaced-alert { border: 1px solid #FECACA; background: #FEF2F2; color: #991B1B; padding: 5px 8px; margin-top: 4px; font-size: 8.2pt; }\n\t.fen-doc .bar-track { width: 100%; height: 7px; background: #E2E8F0; border-radius: 2px; overflow: hidden; }\n\t.fen-doc .bar-fill { height: 7px; background: #0F172A; }\n\t.fen-doc ol, .fen-doc ul { margin: 3px 0; padding-left: 18px; }\n\t.fen-doc .nowrap { white-space: nowrap; }\n</style>\n{% set groups = fen_assembly_summary(doc) %}\n{% set header = fen_company_header(doc.company) %}\n{% macro company_head(kicker, title, ref_no, date_str=\"\", status_label=\"\") %}\n{% if not no_letterhead %}\n<table class=\"header-bar\"><tr>\n\t<td style=\"width:62%; padding-right:10px\">\n\t\t{% if header.logo %}<img src=\"{{ header.logo }}\" style=\"max-height:15mm; max-width:36mm; float:left; margin:0 10px 2px 0\">{% endif %}\n\t\t<div style=\"font-size:12pt; font-weight:700; color:#0F172A\">{{ header.name or doc.company|e }}</div>\n\t\t{% if header.address %}<div class=\"small muted\">{{ header.address }}</div>{% endif %}\n\t\t{% set m = namespace(parts=[]) %}\n\t\t{% if header.phone %}{% set m.parts = m.parts + [_(\"Ph: \") ~ header.phone] %}{% endif %}\n\t\t{% if header.email %}{% set m.parts = m.parts + [header.email] %}{% endif %}\n\t\t{% if header.website %}{% set m.parts = m.parts + [header.website] %}{% endif %}\n\t\t{% if header.tax_id %}{% set m.parts = m.parts + [_(\"Tax ID: \") ~ header.tax_id] %}{% endif %}\n\t\t{% if m.parts %}<div class=\"small muted\">{{ m.parts|join(\" \u00b7 \") }}</div>{% endif %}\n\t</td>\n\t<td style=\"width:38%; text-align:right\">\n\t\t<div class=\"kicker\">{{ kicker }}</div>\n\t\t<h1 style=\"margin:1px 0 3px\">{{ title }}</h1>\n\t\t<div class=\"small\" style=\"color:#334155\"><b>{{ ref_no }}</b>{% if date_str %} &middot; {{ date_str }}{% endif %}{% if status_label %} &nbsp;<span class=\"pill\">{{ status_label }}</span>{% endif %}</div>\n\t</td>\n</tr></table>\n{% endif %}\n{% endmacro %}\n{% set ns = namespace(qty=0, area=0.0, weight=0.0) %}\n{% for g in groups %}\n\t{% set ns.qty = ns.qty + (g.qty or 0) %}\n\t{% set ns.area = ns.area + (g.area_sqft or 0) %}\n\t{% set ns.weight = ns.weight + (g.weight_kg or 0) %}\n{% endfor %}\n<div class=\"fen-doc\">\n{{ company_head(_(\"Manufacturing Schedule\"), _(\"Assembly Summary\"), doc.name, frappe.utils.formatdate(frappe.utils.nowdate())) }}\n\n<table class=\"kpi-strip\"><tr>\n\t<td style=\"width:30%\"><div class=\"kpi-label\">{{ _(\"Project\") }}</div><div class=\"kpi-val\">{{ doc.project_title|e }}</div>{% if doc.customer %}<div class=\"small muted\">{{ doc.customer|e }}</div>{% endif %}</td>\n\t<td style=\"width:18%\"><div class=\"kpi-label\">{{ _(\"Project Code\") }}</div><div class=\"kpi-val\">{{ doc.name }}</div></td>\n\t<td style=\"width:14%\"><div class=\"kpi-label\">{{ _(\"Size Groups\") }}</div><div class=\"kpi-val\">{{ groups|length }}</div></td>\n\t<td style=\"width:12%\"><div class=\"kpi-label\">{{ _(\"Total Qty\") }}</div><div class=\"kpi-val\">{{ \"%g\"|format(ns.qty) }}</div></td>\n\t<td style=\"width:13%\"><div class=\"kpi-label\">{{ _(\"Area (sq.ft)\") }}</div><div class=\"kpi-val\">{{ \"%.3f\"|format(ns.area) }}</div></td>\n\t<td style=\"width:13%\"><div class=\"kpi-label\">{{ _(\"Weight (kg)\") }}</div><div class=\"kpi-val\">{{ \"%.2f\"|format(ns.weight) }}</div></td>\n</tr></table>\n\n<div class=\"section-title\">{{ _(\"Grouped Size Matrix (Largest First)\") }}</div>\n<table>\n\t<thead>\n\t\t<tr>\n\t\t\t<th style=\"width:7%\">{{ _(\"View\") }}</th>\n\t\t\t<th class=\"num\" style=\"width:8%\">{{ _(\"Width\") }}</th>\n\t\t\t<th class=\"num\" style=\"width:8%\">{{ _(\"Height\") }}</th>\n\t\t\t<th style=\"width:12%\">{{ _(\"Design Refs\") }}</th>\n\t\t\t<th style=\"width:12%\">{{ _(\"Typology\") }}</th>\n\t\t\t<th style=\"width:18%\">{{ _(\"Series\") }}</th>\n\t\t\t<th style=\"width:16%\">{{ _(\"Finish / Glazing\") }}</th>\n\t\t\t<th class=\"num\" style=\"width:6%\">{{ _(\"Qty\") }}</th>\n\t\t\t<th class=\"num\" style=\"width:7%\">{{ _(\"Area (sq.ft)\") }}</th>\n\t\t\t<th class=\"num\" style=\"width:6%\">{{ _(\"Weight (kg)\") }}</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t{% for g in groups %}\n\t{% set uri = fen_svg_data_uri(g.svg) %}\n\t<tr>\n\t\t<td style=\"text-align:center\">{% if uri %}<img class=\"thumb\" src=\"{{ uri }}\" alt=\"{{ g.refs }}\">{% else %}<span class=\"muted small\">\u2014</span>{% endif %}</td>\n\t\t<td class=\"num\"><b>{{ \"%g\"|format(g.width or 0) }}</b></td>\n\t\t<td class=\"num\"><b>{{ \"%g\"|format(g.height or 0) }}</b></td>\n\t\t<td><span class=\"pill\">{{ g.refs }}</span></td>\n\t\t<td>{{ g.typology }}</td>\n\t\t<td>{{ g.series }}</td>\n\t\t<td class=\"small\">{{ g.finishes or \"\u2014\" }}{% if g.glasses %}<br><span class=\"muted\">{{ g.glasses }}</span>{% endif %}</td>\n\t\t<td class=\"num\"><b>{{ \"%g\"|format(g.qty) }}</b></td>\n\t\t<td class=\"num\">{{ \"%.3f\"|format(g.area_sqft) }}</td>\n\t\t<td class=\"num\">{{ \"%.2f\"|format(g.weight_kg or 0) }}</td>\n\t</tr>\n\t{% endfor %}\n\t<tr class=\"total-row\">\n\t\t<td colspan=\"7\" class=\"num\">{{ _(\"Total\") }}</td>\n\t\t<td class=\"num\">{{ \"%g\"|format(ns.qty) }}</td>\n\t\t<td class=\"num\">{{ \"%.3f\"|format(ns.area) }}</td>\n\t\t<td class=\"num\">{{ \"%.2f\"|format(ns.weight) }}</td>\n\t</tr>\n\t</tbody>\n</table>\n\n<div class=\"block\" style=\"margin-top:12px\">\n\t<table>\n\t\t<tr><th style=\"width:34%\">{{ _(\"Production Supervisor\") }}</th><th style=\"width:33%\">{{ _(\"Glazing Coordinator\") }}</th><th style=\"width:33%\">{{ _(\"QC Sign-Off\") }}</th></tr>\n\t\t<tr><td class=\"sign\"></td><td class=\"sign\"></td><td class=\"sign\"></td></tr>\n\t</table>\n</div>\n{% if not no_letterhead and footer %}<div class=\"letter-head-footer\">{{ footer }}</div>{% endif %}\n</div>\n",
 "module": "Fenestration",
 "name": "Fenestration Assembly Summary",
 "print_format_type": "Jinja",
 "standard": "Yes"
}
