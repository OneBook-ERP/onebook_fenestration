{
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Fenestration Project",
 "doctype": "Print Format",
 "html": "<style>\n\t@page { size: A4; margin: 12mm; }\n\t.fen-doc { font-family: Inter, Helvetica, Arial, sans-serif; font-size: 9.5pt; color: #171717; line-height: 1.4; }\n\t.fen-doc h1, .fen-doc h2, .fen-doc h3 { color: #171717; margin: 0 0 6px; font-weight: 600; }\n\t.fen-doc h1 { font-size: 15pt; }\n\t.fen-doc h2 { font-size: 11.5pt; }\n\t.fen-doc table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }\n\t.fen-doc th, .fen-doc td { border: 1px solid #D4D4D4; padding: 3px 6px; text-align: left; vertical-align: top; }\n\t.fen-doc th { font-weight: 600; background: #F5F5F5; }\n\t.fen-doc td.num, .fen-doc th.num { text-align: right; }\n\t.fen-doc .muted { color: #525252; }\n\t.fen-doc .block { page-break-inside: avoid; margin-bottom: 14px; }\n\t.fen-doc .page-break-after { page-break-after: always; }\n\t.fen-doc img.drawing { max-width: 60mm; max-height: 60mm; }\n\t.fen-doc .drawing-missing { color: #737373; font-style: italic; padding: 20px 0; }\n\t.fen-doc .caption { font-size: 8pt; color: #525252; text-align: center; }\n\t.fen-doc .box { display: inline-block; width: 11px; height: 11px; border: 1px solid #171717; vertical-align: middle; margin: 0 3px 0 6px; }\n\t.fen-doc .sign { height: 60px; }\n\t.fen-doc .card td { border: 1px solid #D4D4D4; }\n</style>\n{% macro company_head() %}\n{% set header = fen_company_header(doc.company) %}\n{% if not no_letterhead %}\n<table style=\"border:0; border-bottom:1px solid #D4D4D4\"><tr>\n\t<td style=\"border:0; width:20%\">{% if header.logo %}<img src=\"{{ header.logo }}\" style=\"max-height:18mm; max-width:40mm\">{% endif %}</td>\n\t<td style=\"border:0\"><b>{{ header.name }}</b><br>{{ header.address }}</td>\n</tr></table>\n{% endif %}\n{% endmacro %}\n<div class=\"fen-doc\">\n{{ company_head() }}\n{% set groups = fen_assembly_summary(doc) %}\n<h1>{{ _(\"Assembly Summary\") }}</h1>\n<table>\n\t<tr><th>{{ _(\"Project\") }}</th><th>{{ _(\"Project Code\") }}</th><th class=\"num\">{{ _(\"Total Qty\") }}</th></tr>\n\t<tr><td>{{ doc.project_title|e }}</td><td>{{ doc.name }}</td><td class=\"num\">{{ groups|sum(attribute=\"qty\") }}</td></tr>\n</table>\n<table>\n\t<tr><th class=\"num\">{{ _(\"Width\") }}</th><th class=\"num\">{{ _(\"Height\") }}</th><th>{{ _(\"Design Refs\") }}</th><th>{{ _(\"Typology\") }}</th><th>{{ _(\"Series\") }}</th><th class=\"num\">{{ _(\"Qty\") }}</th><th class=\"num\">{{ _(\"Area (sq.ft)\") }}</th></tr>\n\t{% for g in groups %}\n\t<tr><td class=\"num\">{{ g.width }}</td><td class=\"num\">{{ g.height }}</td><td>{{ g.refs }}</td><td>{{ g.typology }}</td><td>{{ g.series }}</td><td class=\"num\">{{ g.qty }}</td><td class=\"num\">{{ g.area_sqft }}</td></tr>\n\t{% endfor %}\n</table>\n{% if not no_letterhead and footer %}<div class=\"letter-head-footer\">{{ footer }}</div>{% endif %}\n</div>\n",
 "module": "Fenestration",
 "name": "Fenestration Assembly Summary",
 "print_format_type": "Jinja",
 "standard": "Yes"
}
